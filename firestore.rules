rules_version = '2';

// Firestore Security Rules for PakFasal.
//
// `cloud_firestore` is used by the Sensor, Learning, and Crop Calendar
// modules. Guest sessions in the mobile app are a purely local flag (see
// AuthSessionController.continueAsGuest) and do NOT create a real Firebase
// Auth session, so `request.auth` is null for guests. Collections that
// guests must be able to read (like Learning content) therefore use public
// read rules instead of `request.auth != null`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user DSS history (BLE/WiFi advice sessions). Guests have no Firebase
    // Auth session. Readings are never edited in place, only created/deleted.
    match /sensor_readings/{readingId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // BLE pairing record: ownerId doc id → claimed ESP32 deviceId.
    match /sensor_bindings/{ownerId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == ownerId;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.data.ownerId == ownerId
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() < 128;
    }

    // ESP32 WiFi live uploads keyed by hardware deviceId. Writes are open to
    // devices that know the id (printed on BLE JSON); reads require auth.
    match /sensor_live/{deviceId} {
      allow read: if request.auth != null;
      allow create, update: if request.resource.data.deviceId == deviceId
        && request.resource.data.soilMoisture is number
        && request.resource.data.phLevel is number
        && request.resource.data.soilMoisture >= 0
        && request.resource.data.soilMoisture <= 100
        && request.resource.data.phLevel >= 0
        && request.resource.data.phLevel <= 14;
      allow delete: if false;
    }

    // DSS rule thresholds. Read-only from the app; edit via the Firebase
    // console only.
    match /sensor_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Learning module content (YouTube video metadata aside, these four
    // collections back "Keera aur Bimariyan" and "Learning Articles").
    // Managed by the separate admin website, so writes require a signed-in
    // admin account there; reads are public so guests and signed-out users
    // browsing the app can see the content too.
    match /learning_crops/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /learning_crop_diseases/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /learning_articles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /learning_article_sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Government schemes — managed by the admin panel; public read so guests
    // and signed-out users can browse schemes in the app.
    match /govt_schemes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Marketplace products — managed by the admin panel; public read so guests
    // and signed-out users can browse listings in the app.
    match /products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user farmer profiles (photoUrl from Cloudinary, etc.).
    // Document id must match the signed-in user's uid.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          !('photoUrl' in request.resource.data)
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() < 2048
          )
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user crop calendar plantings (My Crops). Guests have no Firebase
    // Auth session, so only registered users can read/write their own docs.
    match /crop_plantings/{plantingId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
